# Environment Configuration for Nilayam Heights HMS
# Copy this file to .env and configure your production credentials

# App Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hms
DB_USER=root
DB_PASS=

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false # Set to true when running on HTTPS
